{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src-web/*"
      ],
      "~/components/*": [
        "src-web/components/*"
      ],
      "~/ui/*": [
        "src-web/components/ui/*"
      ],
      "~/hooks/*": [
        "src-web/hooks/*"
      ]
    }
  },
  "include": [
    "src-web"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}